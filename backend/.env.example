# ============================================================
#  Configuration du backend Spot'It
#
#  1. Copie ce fichier en "backend/.env"  (le vrai fichier, jamais sur Git)
#  2. Remplace les valeurs ci-dessous par les tiennes
#  3. Relance le backend : node server.js
# ============================================================


# --- Base de données (OBLIGATOIRE) --------------------------
# Adresse de connexion MongoDB Atlas.
#  - Remplace UTILISATEUR et MOTDEPASSE par ceux de ta base
#    (mot de passe sans caractères spéciaux, sinon il faut les encoder)
#  - Remplace l'adresse du cluster par la tienne (ou demande-la à l'équipe)
#  - Garde "/spotit" avant le "?" : c'est le nom de la base
MONGODB_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/spotit?retryWrites=true&w=majority


# --- Sécurité des connexions (OBLIGATOIRE) ------------------
# Clé secrète qui signe les tokens de connexion (JWT).
# Sans elle, personne ne peut se connecter.
#  - Mets une longue valeur aléatoire (au moins 32 caractères)
#  - Pour en générer une :
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  - La changer déconnecte tous les utilisateurs
#  - Ne jamais la partager publiquement
JWT_SECRET=remplace-moi-par-une-longue-valeur-aleatoire


# --- Serveur (OBLIGATOIRE) ----------------------------------
# Port du backend. L'application Flutter l'appelle par défaut sur
# http://localhost:3000 (réglable avec --dart-define=API_HOST=..., voir le README)
PORT=3000


# --- Service IA (facultatif) --------------------------------
# Adresse du service Python (ai/server.py).
# Si la ligne est absente, la valeur ci-dessous est utilisée.
AI_URL=http://localhost:5000
