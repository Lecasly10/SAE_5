# Copie ce fichier en .env (a la racine du projet) et garde seulement les lignes utiles.
# Avec Docker rien n'est obligatoire : sans .env, tout marche avec une base locale.
# Le fichier .env est ignore par Git, ne le partage jamais.

# Adresse de la base MongoDB. Sans cette ligne, Docker lance une base locale.
# Pour MongoDB Atlas, garde /spotit avant le ? : c'est le nom de la base.
# MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/spotit?retryWrites=true&w=majority

# Cle qui signe les connexions. Sans cette ligne, une cle aleatoire est creee a chaque
# demarrage et tout le monde est deconnecte. Pour en generer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Origines autorisees a appeler l'API, separees par des virgules. Vide = toutes.
# CORS_ORIGIN=http://localhost:8080

# Port de l'application dans le navigateur (8080 par defaut).
# APP_PORT=8080

# Adresse du backend vue par le navigateur (http://localhost:3000 par defaut).
# API_HOST=http://localhost:3000

# Lancement sans Docker uniquement : port du backend et adresse du service IA.
# PORT=3000
# AI_URL=http://localhost:5000
