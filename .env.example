# ============================================================
#  Réglages facultatifs pour lancer le projet avec Docker
#
#  Par défaut, tu n'as RIEN à faire : "docker compose up --build"
#  fonctionne sans ce fichier.
#
#  Pour changer un réglage :
#    1. Copie ce fichier en ".env" (à la racine du projet)
#    2. Décommente (enlève le #) et modifie les lignes voulues
#    3. Relance : docker compose up --build
#  Le fichier ".env" n'est jamais envoyé sur GitHub.
# ============================================================


# Clé secrète qui signe les connexions (JWT).
# Valeur utilisée par défaut en local : dev-only-secret-change-me
# Pour un vrai déploiement, mets une longue valeur aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=remplace-moi-par-une-longue-valeur-aleatoire


# Base de données.
# Par défaut : une base MongoDB locale lancée par Docker (mongodb://mongo:27017/spotit).
# Pour utiliser MongoDB Atlas à la place (base partagée de l'équipe),
# mets ton adresse complète, avec "/spotit" avant le "?" :
# MONGODB_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/spotit?retryWrites=true&w=majority


# Adresse du backend telle que le NAVIGATEUR la voit.
# Par défaut : http://localhost:3000
# À changer seulement si tu ouvres l'application depuis un autre ordinateur
# (mets alors l'adresse IP de la machine qui fait tourner Docker).
# API_HOST=http://localhost:3000


# Port de l'application dans le navigateur.
# Par défaut : 8080  ->  http://localhost:8080
# À changer si le port 8080 est déjà utilisé sur ton ordinateur
# (erreur "port is already allocated"), par exemple 8081.
# APP_PORT=8080
